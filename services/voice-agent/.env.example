# Server-side only. Copy to .env.local; never commit values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# Independent provider adapter boundaries; only openai is implemented today.
STT_PROVIDER=openai
STT_MODEL=whisper-1
MODEL_PROVIDER=openai
TUTOR_MODEL=gpt-4.1-mini
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
# Recording, transcript uploads and traces are explicitly disabled in agent.py.
# No flag enables audio recording. Configure provider data retention separately.
