# Server-only values. Copy to apps/web/.env.local; never use NEXT_PUBLIC_* for these.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Generate a random value of at least 16 characters and share it only with pilot participants.
PILOT_ACCESS_CODE=
# Set to the exact public HTTPS origin when deployed behind a reverse proxy.
# For local development the request URL's origin is used if this is empty.
APP_ORIGIN=
